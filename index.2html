
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080609">
<title>For My Gartera | Forever Friendship</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">

<style>
:root{
 --black:#080609;
 --dark:#100b12;
 --pink:#ff3f9f;
 --pink2:#ff83c1;
 --purple:#a66bff;
 --white:#fff8fc;
 --muted:#b6a7b3;
 --glass:rgba(255,255,255,.055);
 --line:rgba(255,105,180,.2);
 --glow:0 0 35px rgba(255,63,159,.22);
}

*{margin:0;padding:0;box-sizing:border-box}

html{scroll-behavior:smooth;scroll-padding-top:90px}

body{
 background:var(--black);
 color:var(--white);
 font-family:'DM Sans',sans-serif;
 overflow-x:hidden;
}

button,input{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}

::selection{
 background:var(--pink);
 color:white;
}

#app{
 position:relative;
 min-height:100vh;
 overflow:hidden;
 isolation:isolate;
 background:
 radial-gradient(ellipse at 10% 10%,rgba(255,40,140,.11),transparent 35%),
 radial-gradient(ellipse at 90% 35%,rgba(144,60,255,.09),transparent 35%),
 #080609;
}

#app:before{
 content:"";
 position:fixed;
 inset:0;
 pointer-events:none;
 z-index:-1;
 opacity:.12;
 background-image:
 linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
 linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
 background-size:65px 65px;
 mask-image:linear-gradient(to bottom,black,transparent 90%);
}

.container{
 width:min(1150px,90%);
 margin:auto;
}

.pink{color:var(--pink)}
.gradient{
 background:linear-gradient(100deg,#ffacd3,#ff3f9f,#c08bff);
 -webkit-background-clip:text;
 background-clip:text;
 color:transparent;
}

.glass{
 background:linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.025));
 border:1px solid rgba(255,255,255,.12);
 backdrop-filter:blur(22px);
 -webkit-backdrop-filter:blur(22px);
 box-shadow:0 15px 55px rgba(0,0,0,.3);
}

.section{padding:105px 0;position:relative}

.section-head{
 text-align:center;
 margin-bottom:55px;
}

.eyebrow{
 color:var(--pink2);
 font-size:11px;
 letter-spacing:5px;
 font-weight:800;
}

.section-head h2{
 font-family:'Playfair Display',serif;
 font-size:clamp(34px,6vw,59px);
 margin:15px 0;
 font-weight:500;
}

.section-head p{
 color:var(--muted);
 font-size:14px;
 line-height:1.8;
}

.neon-btn{
 display:inline-flex;
 align-items:center;
 justify-content:center;
 gap:9px;
 border:1px solid transparent;
 background:linear-gradient(110deg,#ff3196,#c13bca);
 color:white;
 border-radius:50px;
 padding:15px 26px;
 font-weight:800;
 font-size:13px;
 letter-spacing:.3px;
 box-shadow:0 0 22px rgba(255,63,159,.3);
 transition:.35s;
}

.neon-btn:hover{
 transform:translateY(-4px);
 box-shadow:0 0 40px rgba(255,63,159,.6);
}

.ghost-btn{
 background:rgba(255,255,255,.045);
 color:white;
 border:1px solid rgba(255,255,255,.17);
 padding:14px 24px;
 border-radius:50px;
 transition:.3s;
 font-weight:700;
}

.ghost-btn:hover{
 border-color:var(--pink);
 color:var(--pink2);
 background:rgba(255,63,159,.08);
}

.reveal{
 opacity:0;
 transform:translateY(35px);
 transition:opacity .8s ease,transform .8s ease;
}

.reveal.visible{
 opacity:1;
 transform:translateY(0);
}

/* BACKGROUND EFFECTS */

.ambient{
 position:absolute;
 width:400px;
 height:400px;
 border-radius:50%;
 background:var(--pink);
 filter:blur(160px);
 opacity:.11;
 pointer-events:none;
 z-index:-1;
}

.ambient.one{top:100px;left:-250px}
.ambient.two{top:850px;right:-270px;background:var(--purple)}
.ambient.three{bottom:500px;left:-270px}

/* INTRO SCREEN */

#intro{
 position:fixed;
 inset:0;
 z-index:9999;
 display:flex;
 align-items:center;
 justify-content:center;
 padding:20px;
 background:
 radial-gradient(ellipse at 50% 45%,rgba(255,45,145,.2),transparent 48%),
 #080609;
 transition:opacity .9s,visibility .9s;
}

#intro.hide{
 opacity:0;
 visibility:hidden;
 pointer-events:none;
}

.intro-box{
 max-width:550px;
 width:100%;
 text-align:center;
 padding:50px 30px;
 border-radius:30px;
}

.intro-logo{
 width:100px;
 height:100px;
 border:1px solid rgba(255,105,180,.5);
 box-shadow:0 0 50px rgba(255,63,159,.3),inset 0 0 25px rgba(255,63,159,.15);
 border-radius:50%;
 display:grid;
 place-items:center;
 font-size:43px;
 margin:0 auto 30px;
 animation:pulse 2s infinite;
}

.intro-box h1{
 font-family:'Playfair Display',serif;
 font-size:clamp(39px,8vw,65px);
 line-height:1.1;
}

.intro-box p{
 color:var(--muted);
 font-size:14px;
 line-height:1.9;
 margin:20px 0 30px;
}

.intro-line{
 width:100px;
 height:2px;
 background:linear-gradient(90deg,transparent,var(--pink),transparent);
 margin:20px auto;
}

@keyframes pulse{
 0%,100%{box-shadow:0 0 25px rgba(255,63,159,.2)}
 50%{box-shadow:0 0 65px rgba(255,63,159,.55)}
}

/* NAVIGATION */

.nav{
 position:sticky;
 top:0;
 z-index:100;
 background:rgba(8,6,9,.78);
 backdrop-filter:blur(20px);
 border-bottom:1px solid rgba(255,255,255,.07);
}

.nav-inner{
 min-height:76px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:20px;
}

.brand{
 font-family:'Playfair Display',serif;
 font-size:25px;
 font-weight:700;
 white-space:nowrap;
}

.brand span{color:var(--pink)}

.nav-links{
 display:flex;
 align-items:center;
 gap:25px;
}

.nav-links a{
 font-size:11px;
 font-weight:700;
 color:#c8bbc8;
 transition:.3s;
}

.nav-links a:hover{color:var(--pink)}

.nav-menu{
 display:none;
 background:none;
 color:white;
 border:0;
 font-size:26px;
}

/* HERO */

.hero{
 min-height:760px;
 display:flex;
 align-items:center;
 text-align:center;
 position:relative;
 padding:90px 0;
}

.hero-content{
 max-width:850px;
 margin:auto;
}

.hero-label{
 display:inline-flex;
 gap:9px;
 align-items:center;
 border:1px solid var(--line);
 background:rgba(255,63,159,.06);
 color:#ffacd3;
 border-radius:50px;
 padding:10px 18px;
 font-size:10px;
 letter-spacing:3px;
 font-weight:800;
 margin-bottom:30px;
}

.live-dot{
 width:7px;
 height:7px;
 border-radius:50%;
 background:var(--pink);
 box-shadow:0 0 12px var(--pink);
}

.hero h1{
 font-family:'Playfair Display',serif;
 font-size:clamp(53px,10vw,112px);
 font-weight:500;
 line-height:1.05;
 letter-spacing:-2px;
}

.hero h1 .second{
 display:block;
 font-style:italic;
}

.hero-desc{
 color:#bdb0bc;
 max-width:600px;
 margin:27px auto;
 font-size:15px;
 line-height:2;
}

.hero-actions{
 display:flex;
 justify-content:center;
 gap:14px;
 flex-wrap:wrap;
 margin-top:35px;
}

.hero-bottom{
 margin-top:75px;
 display:flex;
 justify-content:center;
 gap:35px;
 flex-wrap:wrap;
}

.hero-stat{
 border-left:1px solid rgba(255,105,180,.45);
 padding-left:15px;
 text-align:left;
}

.hero-stat strong{
 display:block;
 color:var(--pink2);
 font-size:15px;
}

.hero-stat span{
 font-size:10px;
 color:#a99ba8;
 letter-spacing:1px;
}

.hero-orbit{
 position:relative;
 width:70px;
 height:70px;
 border:1px solid rgba(255,63,159,.3);
 border-radius:50%;
 margin:60px auto 0;
 display:grid;
 place-items:center;
 box-shadow:0 0 40px rgba(255,63,159,.13);
}

.hero-orbit:before{
 content:"";
 position:absolute;
 width:95px;
 height:95px;
 border:1px dashed rgba(255,63,159,.25);
 border-radius:50%;
 animation:rotate 15s linear infinite;
}

.hero-orbit span{font-size:27px}

@keyframes rotate{to{transform:rotate(360deg)}}

/* TICKER */

.ticker{
 overflow:hidden;
 border-top:1px solid rgba(255,63,159,.16);
 border-bottom:1px solid rgba(255,63,159,.16);
 background:rgba(255,63,159,.035);
 padding:17px 0;
}

.ticker-track{
 display:flex;
 width:max-content;
 animation:marquee 28s linear infinite;
}

.ticker-track span{
 color:#ffacd3;
 font-family:'Playfair Display',serif;
 font-size:17px;
 margin:0 35px;
 white-space:nowrap;
}

@keyframes marquee{
 to{transform:translateX(-50%)}
}

/* 3D CARDS */

.tilt{
 transform-style:preserve-3d;
 transition:transform .15s ease;
}

.tilt:after{
 content:"";
 position:absolute;
 inset:0;
 pointer-events:none;
 border-radius:inherit;
 background:radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(255,100,180,.16),transparent 45%);
}

/* LETTER */

.letter-wrap{
 max-width:780px;
 margin:auto;
 padding:45px 35px;
 text-align:center;
 border-radius:30px;
 position:relative;
 overflow:hidden;
}

.letter-wrap:before{
 content:"";
 position:absolute;
 top:-140px;
 right:-100px;
 width:250px;
 height:250px;
 background:var(--pink);
 filter:blur(130px);
 opacity:.18;
}

.letter-intro{
 color:#bcaebe;
 font-size:13px;
 line-height:1.8;
}

.envelope-scene{
 width:220px;
 height:150px;
 margin:35px auto;
 perspective:1000px;
 cursor:pointer;
 position:relative;
}

.envelope{
 width:100%;
 height:100%;
 position:relative;
 background:linear-gradient(145deg,#ff5aa9,#a82d84);
 border-radius:7px;
 box-shadow:0 15px 40px rgba(255,63,159,.25);
}

.envelope:before{
 content:"";
 position:absolute;
 inset:0;
 background:#e94c9a;
 clip-path:polygon(0 0,50% 55%,100% 0);
 transform-origin:top;
 transition:transform .8s;
 z-index:4;
}

.envelope:after{
 content:"";
 position:absolute;
 inset:0;
 background:linear-gradient(135deg,#fa90bf,#b653d1);
 clip-path:polygon(0 100%,50% 43%,100% 100%);
 z-index:3;
}

.envelope.open:before{
 transform:rotateX(180deg);
}

.envelope-heart{
 position:absolute;
 z-index:5;
 top:49%;
 left:50%;
 transform:translate(-50%,-50%);
 font-size:32px;
 transition:.4s;
}

.envelope.open .envelope-heart{opacity:0}

.letter-paper{
 position:absolute;
 z-index:2;
 width:88%;
 height:115px;
 left:6%;
 bottom:5px;
 background:#fff1f7;
 color:#332331;
 padding:15px;
 border-radius:5px;
 transition:transform 1s .2s;
 font-family:'Playfair Display',serif;
 font-size:14px;
}

.envelope.open .letter-paper{
 transform:translateY(-100px);
}

.letter-paper span{
 color:#d52f8c;
 font-size:18px;
}

.letter-content{
 display:none;
 max-width:600px;
 margin:35px auto 0;
 padding:30px;
 border:1px solid var(--line);
 border-radius:20px;
 background:rgba(255,63,159,.045);
 text-align:left;
 line-height:2;
 color:#e7dce7;
 font-size:14px;
 animation:appear .8s;
}

.letter-content.show{display:block}

.letter-content h3{
 font-family:'Playfair Display',serif;
 color:var(--pink2);
 font-size:28px;
 margin-bottom:15px;
}

@keyframes appear{
 from{opacity:0;transform:translateY(20px)}
 to{opacity:1;transform:translateY(0)}
}

/* MEMORY GALLERY */

.memory-grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:22px;
}

.memory-card{
 padding:13px;
 border-radius:22px;
 position:relative;
 overflow:hidden;
 cursor:default;
}

.memory-card:hover{
 border-color:rgba(255,63,159,.5);
 box-shadow:var(--glow);
}

.memory-image{
 height:265px;
 background:
 radial-gradient(circle at 50% 40%,rgba(255,63,159,.25),transparent 60%),
 #171019;
 border-radius:15px;
 display:grid;
 place-items:center;
 overflow:hidden;
 position:relative;
}

.memory-image img{
 width:100%;
 height:100%;
 object-fit:cover;
 display:none;
 cursor:zoom-in;
 transition:transform .6s;
}

.memory-card:hover img{transform:scale(1.06)}

.memory-image .placeholder{
 text-align:center;
 color:#ff9bc8;
}

.placeholder strong{
 display:block;
 font-size:38px;
 margin-bottom:10px;
}

.placeholder span{
 display:block;
 font-size:10px;
 letter-spacing:2px;
 color:#b8a8b8;
}

.memory-info{padding:18px 5px 8px}

.memory-info h3{
 font-family:'Playfair Display',serif;
 font-size:21px;
 font-weight:500;
 margin-bottom:7px;
}

.memory-info p{
 color:#a99eab;
 font-size:12px;
 line-height:1.7;
 min-height:40px;
}

.memory-upload{
 display:inline-block;
 margin-top:13px;
 padding:10px 15px;
 background:rgba(255,63,159,.08);
 border:1px solid rgba(255,63,159,.3);
 color:#ffacd3;
 border-radius:50px;
 font-size:10px;
 font-weight:800;
 cursor:pointer;
}

.memory-upload input{display:none}

/* LIGHTBOX */

#lightbox{
 position:fixed;
 inset:0;
 z-index:500;
 background:rgba(0,0,0,.94);
 display:none;
 align-items:center;
 justify-content:center;
 padding:25px;
}

#lightbox.show{display:flex}

#lightbox img{
 max-width:90%;
 max-height:85vh;
 object-fit:contain;
 border-radius:15px;
 box-shadow:0 0 50px rgba(255,63,159,.2);
}

#lightbox button{
 position:absolute;
 top:25px;
 right:30px;
 color:white;
 background:none;
 border:0;
 font-size:35px;
}

/* FUNNY DRAMA */

.drama-box{
 max-width:750px;
 margin:auto;
 text-align:center;
 padding:50px 30px;
 border-radius:28px;
}

.drama-emoji{
 font-size:65px;
 margin-bottom:20px;
 filter:drop-shadow(0 0 20px rgba(255,63,159,.4));
}

#funnyText{
 font-family:'Playfair Display',serif;
 font-size:clamp(23px,4vw,35px);
 line-height:1.5;
 min-height:110px;
 display:grid;
 place-items:center;
 transition:.3s;
}

.drama-counter{
 color:#a99baa;
 font-size:10px;
 letter-spacing:2px;
 margin:15px 0 25px;
}

/* QUIZ */

.quiz-card{
 max-width:720px;
 margin:auto;
 padding:40px;
 border-radius:28px;
}

.quiz-progress{
 height:5px;
 border-radius:50px;
 background:rgba(255,255,255,.1);
 overflow:hidden;
 margin:25px 0 35px;
}

.quiz-progress span{
 display:block;
 width:25%;
 height:100%;
 background:linear-gradient(90deg,#ff329a,#bb65ff);
 transition:.4s;
}

.quiz-number{
 color:var(--pink2);
 font-size:10px;
 letter-spacing:3px;
 font-weight:800;
}

#question{
 font-family:'Playfair Display',serif;
 font-size:clamp(24px,4vw,35px);
 margin:15px 0 30px;
}

.quiz-options{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:14px;
}

.quiz-option{
 padding:17px;
 color:white;
 border:1px solid rgba(255,255,255,.12);
 background:rgba(255,255,255,.035);
 border-radius:15px;
 transition:.3s;
 text-align:left;
}

.quiz-option:hover:not(:disabled){
 border-color:var(--pink);
 background:rgba(255,63,159,.1);
 transform:translateY(-3px);
}

.quiz-option:disabled{opacity:.65;cursor:default}

.quiz-option.correct{
 border-color:#53d9a4;
 background:rgba(83,217,164,.12);
}

.quiz-option.wrong{
 border-color:#ff6262;
 background:rgba(255,98,98,.1);
}

#quizResult{
 margin-top:25px;
 min-height:50px;
 color:#ffacd3;
 font-size:14px;
 line-height:1.8;
}

.quiz-footer{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
 flex-wrap:wrap;
}

#scoreText{
 font-size:11px;
 color:#c1b3c1;
}

/* MUSIC */

.music-player{
 max-width:600px;
 margin:auto;
 padding:35px;
 border-radius:28px;
}

.music-top{
 display:flex;
 align-items:center;
 gap:22px;
}

.album-art{
 width:115px;
 height:115px;
 flex-shrink:0;
 display:grid;
 place-items:center;
 border-radius:22px;
 font-size:48px;
 background:linear-gradient(135deg,#ff329a,#873cc8);
 box-shadow:0 0 30px rgba(255,63,159,.3);
}

.album-art.playing{animation:albumPulse 2s infinite}

@keyframes albumPulse{
 50%{box-shadow:0 0 45px rgba(255,63,159,.7);transform:scale(1.03)}
}

.music-details h3{
 font-family:'Playfair Display',serif;
 font-size:25px;
 margin-bottom:7px;
}

.music-details p{
 color:#b8a9b9;
 font-size:12px;
 line-height:1.7;
}

.music-upload{
 display:inline-block;
 margin-top:18px;
 font-size:11px;
 color:#ff9dc9;
 border-bottom:1px solid #ff9dc9;
 cursor:pointer;
 padding-bottom:4px;
}

.music-upload input{display:none}

.audio-progress{
 margin:28px 0 12px;
}

.audio-progress input{
 width:100%;
 accent-color:var(--pink);
 cursor:pointer;
}

.audio-time{
 display:flex;
 justify-content:space-between;
 font-size:10px;
 color:#a89aaa;
}

.music-controls{
 display:flex;
 justify-content:center;
 align-items:center;
 gap:22px;
 margin:25px 0 10px;
}

.music-controls button{
 border:0;
 background:transparent;
 color:white;
 font-size:21px;
}

.music-controls .play{
 width:58px;
 height:58px;
 border-radius:50%;
 background:linear-gradient(120deg,#ff329a,#b74be0);
 font-size:24px;
 box-shadow:0 0 25px rgba(255,63,159,.4);
}

.music-status{
 text-align:center;
 color:#bcaabd;
 font-size:11px;
 margin-top:15px;
}

/* FINAL SURPRISE */

.final-card{
 max-width:820px;
 margin:auto;
 padding:55px 35px;
 text-align:center;
 border-radius:32px;
 position:relative;
 overflow:hidden;
}

.final-card:before{
 content:"";
 position:absolute;
 width:260px;
 height:260px;
 left:50%;
 top:10%;
 transform:translateX(-50%);
 background:var(--pink);
 filter:blur(130px);
 opacity:.15;
 pointer-events:none;
}

.big-heart{
 font-size:80px;
 display:block;
 animation:heartbeat 1.6s infinite;
 filter:drop-shadow(0 0 20px rgba(255,63,159,.5));
}

@keyframes heartbeat{
 0%,100%{transform:scale(1)}
 15%{transform:scale(1.15)}
 30%{transform:scale(1)}
 45%{transform:scale(1.1)}
}

.final-card h2{
 font-family:'Playfair Display',serif;
 font-size:clamp(35px,7vw,55px);
 margin:25px 0;
}

.final-card>p{
 color:#c0b3c1;
 font-size:14px;
 line-height:2;
 max-width:600px;
 margin:0 auto 30px;
}

.final-buttons{
 display:flex;
 justify-content:center;
 gap:13px;
 flex-wrap:wrap;
}

#finalMessage{
 display:none;
 margin-top:35px;
 padding:30px;
 border-radius:20px;
 background:rgba(255,63,159,.07);
 border:1px solid rgba(255,63,159,.3);
 animation:appear .7s;
}

#finalMessage.show{display:block}

#finalMessage h3{
 color:#ff9dcb;
 font-family:'Playfair Display',serif;
 font-size:30px;
 margin:15px 0;
}

#finalMessage p{
 color:#e7d9e7;
 line-height:2;
 font-size:14px;
}

#thinkMessage{
 display:none;
 color:#ffacd3;
 margin-top:25px;
 font-size:13px;
 line-height:1.8;
}

/* FRIENDSHIP FOOTER */

.footer{
 padding:65px 20px 35px;
 text-align:center;
 border-top:1px solid rgba(255,63,159,.15);
}

.footer-logo{
 font-family:'Playfair Display',serif;
 font-size:30px;
 margin-bottom:13px;
}

.footer p{
 color:#9c8e9e;
 font-size:11px;
 line-height:2;
}

.footer-heart{
 color:var(--pink);
}

/* HEART PARTICLES */

.particle{
 position:fixed;
 z-index:600;
 pointer-events:none;
 animation:particleFly 2.5s ease-out forwards;
 filter:drop-shadow(0 0 8px #ff3f9f);
}

@keyframes particleFly{
 0%{opacity:1;transform:translate(0,0) scale(.5)}
 100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(360deg) scale(1.5)}
}

.confetti{
 position:fixed;
 top:-20px;
 width:8px;
 height:12px;
 z-index:700;
 pointer-events:none;
 animation:confettiFall linear forwards;
}

@keyframes confettiFall{
 to{transform:translateY(110vh) rotate(900deg);opacity:0}
}

/* SCROLL TOP */

#topBtn{
 position:fixed;
 right:22px;
 bottom:22px;
 z-index:90;
 width:45px;
 height:45px;
 border-radius:50%;
 border:1px solid rgba(255,63,159,.4);
 background:rgba(20,10,20,.8);
 color:var(--pink);
 font-size:19px;
 opacity:0;
 visibility:hidden;
 transition:.3s;
}

#topBtn.show{opacity:1;visibility:visible}

/* MOBILE */

@media(max-width:850px){
 .nav-links{
  display:none;
  position:absolute;
  top:76px;
  left:0;
  right:0;
  padding:25px;
  flex-direction:column;
  background:rgba(8,6,9,.97);
  border-bottom:1px solid var(--line);
 }
 .nav-links.open{display:flex}
 .nav-menu{display:block}
 .memory-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:550px){
 .container{width:91%}
 .section{padding:75px 0}
 .hero{min-height:690px;padding:75px 0}
 .hero h1{letter-spacing:-1px}
 .hero-desc{font-size:13px}
 .hero-bottom{gap:18px}
 .memory-grid{grid-template-columns:1fr}
 .memory-card{max-width:380px;width:100%;margin:auto}
 .memory-image{height:260px}
 .letter-wrap,.quiz-card,.drama-box,.music-player,.final-card{padding:28px 19px}
 .quiz-options{grid-template-columns:1fr}
 .music-top{flex-direction:column;text-align:center}
 .album-art{width:105px;height:105px}
 .final-buttons{flex-direction:column}
 .final-buttons button{width:100%}
 .nav-inner{min-height:68px}
 .nav-links{top:68px}
}

@media(prefers-reduced-motion:reduce){
 *,*:before,*:after{
  scroll-behavior:auto!important;
  animation-duration:.01ms!important;
  transition-duration:.01ms!important;
 }
}
</style>
</head>

<body>

<div id="app">

<div class="ambient one"></div>
<div class="ambient two"></div>
<div class="ambient three"></div>

<!-- INTRO -->

<div id="intro">
 <div class="intro-box glass">
  <div class="intro-logo">♡</div>
  <div class="eyebrow">A SPECIAL SURPRISE FOR YOU</div>
  <div class="intro-line"></div>
  <h1>Hey, <span class="gradient">Gartera!</span></h1>
  <p>
   I made a little world just for you.
   A place for our memories, our silly fights,
   and all the things I don't always say.
   <br><br>
   Are you ready? 🥹
  </p>
  <button class="neon-btn" onclick="startWebsite()">
   ENTER MY LITTLE WORLD ✨
  </button>
 </div>
</div>

<!-- NAV -->

<nav class="nav">
 <div class="container nav-inner">
  <a class="brand" href="#home">FOR MY <span>GARTERA.</span></a>

  <div class="nav-links" id="navLinks">
   <a href="#home">HOME</a>
   <a href="#letter">LETTER</a>
   <a href="#memories">MEMORIES</a>
   <a href="#drama">DRAMA</a>
   <a href="#quiz">QUIZ</a>
   <a href="#surprise">SURPRISE</a>
  </div>

  <button class="nav-menu" id="menuBtn"
   onclick="toggleMenu()" aria-label="Open menu">☰</button>
 </div>
</nav>

<!-- HERO -->

<section class="hero" id="home">
 <div class="container hero-content reveal">

  <div class="hero-label">
   <span class="live-dot"></span>
   A FRIENDSHIP THAT MEANS EVERYTHING
  </div>

  <h1>
   To My
   <span class="second gradient">Favorite Gartera.</span>
  </h1>

  <p class="hero-desc">
   We argue. We get angry. We stop talking.
   But somehow, we always find our way back to each other.
   Maybe that's what makes our friendship special. 🖤
  </p>

  <div class="hero-actions">
   <a href="#letter" class="neon-btn">READ MY LETTER 💌</a>
   <a href="#memories" class="ghost-btn">EXPLORE OUR WORLD ↗</a>
  </div>

  <div class="hero-bottom">
   <div class="hero-stat">
    <strong>100%</strong>
    <span>UNLIMITED DRAMA</span>
   </div>
   <div class="hero-stat">
    <strong>∞</strong>
    <span>MEMORIES</span>
   </div>
   <div class="hero-stat">
    <strong>1</strong>
    <span>IRREPLACEABLE FRIEND</span>
   </div>
  </div>

  <div class="hero-orbit"><span>♡</span></div>

 </div>
</section>

<!-- MOVING TEXT -->

<div class="ticker">
 <div class="ticker-track">
  <span>♡ FRIENDSHIP FOREVER</span>
  <span>♡ TOO MUCH DRAMA</span>
  <span>♡ UNLIMITED MEMORIES</span>
  <span>♡ MY FAVORITE HUMAN</span>
  <span>♡ FRIENDSHIP FOREVER</span>
  <span>♡ TOO MUCH DRAMA</span>
  <span>♡ UNLIMITED MEMORIES</span>
  <span>♡ MY FAVORITE HUMAN</span>
 </div>
</div>

<!-- LETTER -->

<section class="section" id="letter">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">01 / A LETTER FROM MY HEART</div>
   <h2>Words I Don't Always <span class="gradient">Say.</span></h2>
   <p>Some feelings are easier to write than to say.</p>
  </div>

  <div class="letter-wrap glass reveal tilt">

   <div class="eyebrow">PRIVATE MESSAGE • JUST FOR YOU</div>
   <p class="letter-intro" style="margin-top:12px">
    There's something inside this little envelope.
    Open it when you're ready. 💗
   </p>

   <div class="envelope-scene" onclick="openLetter()">
    <div class="envelope" id="envelope">
     <div class="letter-paper">
      <span>For My Gartera ♡</span>
      <br>With love...
     </div>
     <div class="envelope-heart">♥</div>
    </div>
   </div>

   <button class="neon-btn" onclick="openLetter()">
    OPEN MY LETTER 💌
   </button>

   <div class="letter-content" id="letterContent">
    <h3>Dear Gartera, ♡</h3>

    <p>
     তোমার সাথে যতই ঝগড়া করি,
     তোর সাথে কথা না বলে থাকতে পারি না।
     <br><br>

     মাঝে মাঝে তোমার উপর এত রাগ হয় যে মনে হয়,
     আর কোনোদিন কথা বলব না!
     কিন্তু কিছুক্ষণ পরেই আবার তোর কথাই মনে পড়ে।
     😂
     <br><br>

     আমি হয়তো সবসময় সুন্দর করে কথা বলতে পারি না।
     কখনো রাগ করি, কখনো অভিমান করি,
     কিন্তু খুব মিস করি
     <br><br>
     <span class="pink" style="font-weight:800">
      তুমি আমার favourite বিরক্তিকর মানুষ! 😂❤️
     </span>
     <br><br>

     With unlimited love, complaints and care,
     <br>
     Your Favourite Human. 🖤
    </p>
   </div>

  </div>
 </div>
</section>

<!-- MEMORIES -->

<section class="section" id="memories">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">02 / OUR LITTLE UNIVERSE</div>
   <h2>Memories That <span class="gradient">Stay.</span></h2>
   <p>Three little spaces for your favourite memories together.</p>
  </div>

  <div class="memory-grid">

   <div class="memory-card glass tilt reveal">
    <div class="memory-image">
     <div class="placeholder">
      <strong>♡</strong>
      <span>YOUR MEMORY HERE</span>
     </div>
     <img alt="Our first memory" onclick="showPhoto(this)">
    </div>
    <div class="memory-info">
     <h3>Our Beautiful Moments</h3>
     <p>Every little moment with you is special.</p>
     <label class="memory-upload">
      + ADD YOUR PHOTO
      <input type="file" accept="image/*"
       onchange="uploadPhoto(this)">
     </label>
    </div>
   </div>

   <div class="memory-card glass tilt reveal">
    <div class="memory-image">
     <div class="placeholder">
      <strong>✦</strong>
      <span>YOUR MEMORY HERE</span>
     </div>
     <img alt="Our crazy moments" onclick="showPhoto(this)">
    </div>
    <div class="memory-info">
     <h3>Our Crazy Adventures</h3>
     <p>Because normal is boring when we're together.</p>
     <label class="memory-upload">
      + ADD YOUR PHOTO
      <input type="file" accept="image/*"
       onchange="uploadPhoto(this)">
     </label>
    </div>
   </div>

   <div class="memory-card glass tilt reveal">
    <div class="memory-image">
     <div class="placeholder">
      <strong>∞</strong>
      <span>YOUR MEMORY HERE</span>
     </div>
     <img alt="Forever friendship" onclick="showPhoto(this)">
    </div>
    <div class="memory-info">
     <h3>Forever Us</h3>
     <p>Some friendships deserve a forever.</p>
     <label class="memory-upload">
      + ADD YOUR PHOTO
      <input type="file" accept="image/*"
       onchange="uploadPhoto(this)">
     </label>
    </div>
   </div>

  </div>
 </div>
</section>

<!-- PHOTO LIGHTBOX -->

<div id="lightbox" onclick="closePhoto(event)">
 <button aria-label="Close image">×</button>
 <img id="lightboxImage" alt="Memory preview">
</div>

<!-- DRAMA -->

<section class="section" id="drama">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">03 / THE DAILY DRAMA</div>
   <h2>Our Friendship Is <span class="gradient">Crazy.</span></h2>
   <p>Warning: Too much attitude, too much love! 😂</p>
  </div>

  <div class="drama-box glass reveal tilt">
   <div class="drama-emoji" id="dramaEmoji">🤣</div>

   <div id="funnyText">
    Our friendship is 50% love,
    50% fighting and 100% drama!
   </div>

   <div class="drama-counter" id="dramaCounter">
    DRAMA MOMENT 01
   </div>

   <button class="neon-btn" onclick="nextDrama()">
    SHOW ANOTHER DRAMA ↗
   </button>
  </div>

 </div>
</section>

<!-- QUIZ -->

<section class="section" id="quiz">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">04 / THE FRIENDSHIP CHALLENGE</div>
   <h2>How Well Do You <span class="gradient">Know Us?</span></h2>
   <p>Let's see if you really know our friendship! 😎</p>
  </div>

  <div class="quiz-card glass reveal">

   <div class="quiz-number" id="quizNumber">QUESTION 01 / 05</div>

   <div class="quiz-progress">
    <span id="quizProgress"></span>
   </div>

   <h3 id="question">আমাদের মধ্যে বেশি রাগী কে?</h3>

   <div class="quiz-options" id="quizOptions"></div>

   <div id="quizResult"></div>

   <div class="quiz-footer">
    <span id="scoreText">YOUR SCORE: 0</span>
    <button class="neon-btn" id="nextQuestion"
     onclick="nextQuiz()" style="display:none">
     NEXT QUESTION →
    </button>
   </div>

  </div>
 </div>
</section>

<!-- MUSIC -->

<section class="section" id="music">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">05 / A LITTLE MUSIC</div>
   <h2>Our Special <span class="gradient">Melody.</span></h2>
   <p>Choose a song that reminds you of your friendship.</p>
  </div>

  <div class="music-player glass reveal">

   <div class="music-top">
    <div class="album-art" id="albumArt">♫</div>
    <div class="music-details">
     <div class="eyebrow">NOW PLAYING</div>
     <h3 id="songName">Our Friendship Playlist</h3>
     <p id="songArtist">A little melody for Gartera ♡</p>

     <label class="music-upload">
      + UPLOAD YOUR FAVOURITE SONG
      <input type="file" id="musicFile" accept="audio/*">
     </label>
    </div>
   </div>

   <div class="audio-progress">
    <input type="range" id="progress" min="0" max="100" value="0">
    <div class="audio-time">
     <span id="currentTime">0:00</span>
     <span id="duration">0:00</span>
    </div>
   </div>

   <div class="music-controls">
    <button onclick="restartSong()" aria-label="Restart">↺</button>
    <button class="play" id="playButton"
     onclick="toggleMusic()" aria-label="Play">▶</button>
    <button onclick="stopMusic()" aria-label="Stop">■</button>
   </div>

   <div class="music-status" id="musicStatus">
    Choose an audio file to start your music.
   </div>

   <audio id="audio" preload="metadata"></audio>

  </div>
 </div>
</section>

<!-- FINAL SURPRISE -->

<section class="section" id="surprise">
 <div class="container">

  <div class="section-head reveal">
   <div class="eyebrow">06 / THE MOST IMPORTANT PART</div>
   <h2>One Last <span class="gradient">Question.</span></h2>
   <p>I've saved something special for the end.</p>
  </div>

  <div class="final-card glass reveal">

   <span class="big-heart">♥</span>

   <div class="eyebrow">JUST BETWEEN US</div>

   <h2>Will You Forgive Me, Gartera?</h2>

   <p>
    I know we fight sometimes.
    We get angry over little things,
    and sometimes we don't understand each other.
    <br><br>
    But I never want a little argument
    to become bigger than our friendship.
    <br><br>
    So, can we smile again?
   </p>

   <div class="final-buttons">
    <button class="neon-btn" onclick="forgiveMe()">
     YES, OF COURSE! ♡
    </button>

    <button class="ghost-btn" onclick="notYet()">
     I'M STILL ANGRY! 😂
    </button>
   </div>

   <div id="thinkMessage">
    beng
   </div>

   <div id="finalMessage">
    <div style="font-size:65px">🥹💗</div>

    <h3>YOU ARE SPECIAL, GARTERA.</h3>

    <p>
     Thank you for being a part of my life.
     <br>
     No matter how many times we fight,
     I will always treasure our friendship.
     <br><br>
     আর হ্যাঁ, তুমি কিন্তু অনেক বিরক্তিকর!
     কিন্তু আমার সবচেয়ে প্রিয় বিরক্তিকর মানুষ। 😂
     <br><br>
     Stay happy. Stay crazy. Stay with me as a friend.
     <br><br>
     <strong style="color:#ff83c1">
      FRIENDSHIP FOREVER. ♡
     </strong>
    </p>
   </div>

  </div>
 </div>
</section>

<footer class="footer">
 <div class="footer-logo">FOR MY <span class="pink">GARTERA.</span></div>
 <p>
  A little world made with love, care and unlimited drama.
  <br>
  Designed with <span class="footer-heart">♥</span> just for you.
 </p>
 <p style="margin-top:20px">© 2026 • FOREVER FRIENDS</p>
</footer>

<button id="topBtn" onclick="window.scrollTo({top:0,behavior:'smooth'})"
 aria-label="Back to top">↑</button>

</div>

<script>

/* =================================
   01. INTRO
================================= */

function startWebsite(){
 document.getElementById('intro').classList.add('hide');
 createHearts(18);
}

/* =================================
   02. MOBILE MENU
================================= */

function toggleMenu(){
 document.getElementById('navLinks').classList.toggle('open');
}

document.querySelectorAll('.nav-links a').forEach(link=>{
 link.addEventListener('click',()=>{
  document.getElementById('navLinks').classList.remove('open');
 });
});

/* =================================
   03. SCROLL ANIMATION
================================= */

const observer=new IntersectionObserver(entries=>{
 entries.forEach(entry=>{
  if(entry.isIntersecting){
   entry.target.classList.add('visible');
   observer.unobserve(entry.target);
  }
 });
},{threshold:.12});

document.querySelectorAll('.reveal').forEach(el=>{
 observer.observe(el);
});

/* =================================
   04. 3D TILT EFFECT
================================= */

const isTouch=window.matchMedia('(hover: none)').matches;

if(!isTouch){
 document.querySelectorAll('.tilt').forEach(card=>{
  card.addEventListener('mousemove',e=>{
   const rect=card.getBoundingClientRect();
   const x=e.clientX-rect.left;
   const y=e.clientY-rect.top;

   const rx=((y/rect.height)-.5)*-5;
   const ry=((x/rect.width)-.5)*5;

   card.style.transform=
    `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;

   card.style.setProperty('--mx',x+'px');
   card.style.setProperty('--my',y+'px');
  });

  card.addEventListener('mouseleave',()=>{
   card.style.transform='';
  });
 });
}

/* =================================
   05. FLOATING HEART PARTICLES
================================= */

function createHearts(amount=1){
 for(let i=0;i<amount;i++){
  const heart=document.createElement('span');
  heart.className='particle';
  heart.textContent=['♥','♡','💗','✦','💕'][Math.floor(Math.random()*5)];

  const angle=Math.random()*Math.PI*2;
  const distance=80+Math.random()*220;

  heart.style.left=(30+Math.random()*40)+'%';
  heart.style.top=(35+Math.random()*30)+'%';
  heart.style.fontSize=(14+Math.random()*22)+'px';
  heart.style.setProperty('--dx',Math.cos(angle)*distance+'px');
  heart.style.setProperty('--dy',Math.sin(angle)*distance+'px');

  document.body.appendChild(heart);
  setTimeout(()=>heart.remove(),2700);
 }
}

setInterval(()=>{
 if(!document.hidden){
  createHearts(1);
 }
},1300);

/* =================================
   06. ENVELOPE LETTER
================================= */

let letterOpened=false;

function openLetter(){
 const envelope=document.getElementById('envelope');
 const content=document.getElementById('letterContent');

 envelope.classList.toggle('open');

 if(!letterOpened){
  letterOpened=true;

  setTimeout(()=>{
   content.classList.add('show');
   content.scrollIntoView({behavior:'smooth',block:'nearest'});
   createHearts(15);
  },750);
 }else{
  content.classList.toggle('show');
 }
}

/* =================================
   07. PHOTO UPLOAD & LIGHTBOX
================================= */

function uploadPhoto(input){
 const file=input.files[0];
 if(!file)return;

 if(!file.type.startsWith('image/')){
  alert('Please select a valid image.');
  return;
 }

 if(file.size>12*1024*1024){
  alert('Please choose an image smaller than 12 MB.');
  return;
 }

 const card=input.closest('.memory-card');
 const img=card.querySelector('.memory-image img');
 const placeholder=card.querySelector('.placeholder');

 if(img.dataset.url){
  URL.revokeObjectURL(img.dataset.url);
 }

 const url=URL.createObjectURL(file);

 img.src=url;
 img.dataset.url=url;
 img.style.display='block';
 placeholder.style.display='none';
}

function showPhoto(img){
 if(!img.src)return;

 document.getElementById('lightboxImage').src=img.src;
 document.getElementById('lightbox').classList.add('show');
}

function closePhoto(e){
 if(e.target.id==='lightbox'||e.target.tagName==='BUTTON'){
  document.getElementById('lightbox').classList.remove('show');
 }
}

document.addEventListener('keydown',e=>{
 if(e.key==='Escape'){
  document.getElementById('lightbox').classList.remove('show');
 }
});

/* =================================
   08. FUNNY DRAMA GENERATOR
================================= */

const dramaMessages=[
 {e:'🤣',t:'আমাদের বন্ধুত্বে শান্তি নেই, কিন্তু একে অপরকে ছাড়া চলেও না!'},
 {e:'😤',t:'তুই রাগ করিস, আমি রাগ করি, তারপর দুজনেই কথা বলার অপেক্ষায় থাকি!'},
 {e:'😂',t:'তুই আমার জীবনের সবচেয়ে বিরক্তিকর Favourite Person!'},
 {e:'🥹',t:'ঝগড়া করে থাকব বলি, কিন্তু পাঁচ মিনিট পরেই তোর কথা মনে পড়ে!'},
 {e:'👑',t:'আমাদের বন্ধুত্বে Drama Queen দুজনেই!'},
 {e:'😭',t:'আমাদের ঝগড়ার জন্য আলাদা একটা আদালত খোলা উচিত!'},
 {e:'💗',t:'রাগ অনেক, অভিমান অনেক, কিন্তু যত্নটাও অনেক!'},
 {e:'🤦‍♀️',t:'আমাদের বন্ধুত্ব একটা Comedy Show, প্রতিদিন নতুন Episode!'}
];

let dramaIndex=0;

function nextDrama(){
 dramaIndex=(dramaIndex+1)%dramaMessages.length;

 const box=document.getElementById('funnyText');
 box.style.opacity=0;
 box.style.transform='translateY(12px)';

 setTimeout(()=>{
  document.getElementById('dramaEmoji').textContent=dramaMessages[dramaIndex].e;
  box.textContent=dramaMessages[dramaIndex].t;
  document.getElementById('dramaCounter').textContent=
   'DRAMA MOMENT '+String(dramaIndex+1).padStart(2,'0');

  box.style.opacity=1;
  box.style.transform='translateY(0)';
 },250);
}

/* =================================
   09. FRIENDSHIP QUIZ
================================= */

const questions=[
 {
  q:'আমাদের মধ্যে বেশি রাগী কে?',
  a:['আমি 😎','Gartera 😤','দুজনেই 😂','কেউ না 🥰'],
  c:2,
  correct:'একদম ঠিক! দুজনেই রাগের কারখানা! 😂',
  wrong:'ভুল! দুজনেই কম যায় না! 🤣'
 },
 {
  q:'ঝগড়ার পর কার আগে কথা বলতে ইচ্ছা করে?',
  a:['আমার 💗','Gartera 💕','দুজনেরই 🥹','কেউ কথা বলে না'],
  c:2,
  correct:'হ্যাঁ! দুজনেই মনে মনে অপেক্ষা করি! 🥹',
  wrong:'আসলে দুজনেই অপেক্ষা করি! 😂'
 },
 {
  q:'আমাদের বন্ধুত্বে সবচেয়ে বেশি কী আছে?',
  a:['রাগ 😤','অভিমান 😭','ভালোবাসা ও যত্ন ❤️','ঝগড়া 🤣'],
  c:2,
  correct:'এই তো! ঝগড়ার মাঝেও যত্নটাই আসল! ❤️',
  wrong:'ঝগড়া আছে, কিন্তু যত্নটাই বেশি মূল্যবান! 💗'
 },
 {
  q:'আমরা কি একে অপরকে ছাড়া থাকতে পারব?',
  a:['অবশ্যই পারব','হয়তো পারব','কঠিন হবে 🥹','একদমই না 💗'],
  c:3,
  correct:'এই উত্তরটাই আমার সবচেয়ে পছন্দ! 🥹',
  wrong:'না না, এত সহজে পার পাওয়া যাবে না! 😂'
 },
 {
  q:'এই ওয়েবসাইটটি কার জন্য বানানো?',
  a:['অন্য কারও জন্য','আমার নিজের জন্য','Gartera-এর জন্য 💗','গোপন!'],
  c:2,
  correct:'তুমি ঠিকই ধরেছো! এটা শুধু তোমার জন্য! 💗',
  wrong:'আবার ভাবো! এই পুরো ওয়েবসাইট কার জন্য? 😁'
 }
];

let quizIndex=0;
let score=0;
let answered=false;

function loadQuiz(){
 const q=questions[quizIndex];

 document.getElementById('quizNumber').textContent=
  'QUESTION '+String(quizIndex+1).padStart(2,'0')+' / 05';

 document.getElementById('quizProgress').style.width=
  ((quizIndex+1)/questions.length*100)+'%';

 document.getElementById('question').textContent=q.q;

 document.getElementById('quizResult').textContent='';
 document.getElementById('scoreText').textContent='YOUR SCORE: '+score;
 document.getElementById('nextQuestion').style.display='none';

 const options=document.getElementById('quizOptions');
 options.innerHTML='';

 q.a.forEach((answer,index)=>{
  const button=document.createElement('button');
  button.className='quiz-option';
  button.textContent=answer;
  button.onclick=()=>answerQuiz(index);
  options.appendChild(button);
 });

 answered=false;
}

function answerQuiz(index){
 if(answered)return;
 answered=true;

 const q=questions[quizIndex];
 const buttons=document.querySelectorAll('.quiz-option');

 buttons.forEach((button,i)=>{
  button.disabled=true;
  if(i===q.c)button.classList.add('correct');
  else if(i===index)button.classList.add('wrong');
 });

 if(index===q.c){
  score++;
  document.getElementById('quizResult').textContent=q.correct;
  createHearts(7);
 }else{
  document.getElementById('quizResult').textContent=q.wrong;
 }

 document.getElementById('scoreText').textContent='YOUR SCORE: '+score;
 document.getElementById('nextQuestion').style.display='inline-flex';
 document.getElementById('nextQuestion').textContent=
  quizIndex===questions.length-1?'SEE FINAL RESULT →':'NEXT QUESTION →';
}

function nextQuiz(){
 if(!answered)return;

 if(quizIndex<questions.length-1){
  quizIndex++;
  loadQuiz();
 }else{
  showQuizResult();
 }
}

function showQuizResult(){
 const card=document.querySelector('.quiz-card');

 card.innerHTML=`
  <div style="text-align:center;padding:25px 5px">
   <div style="font-size:65px">🏆</div>
   <div class="eyebrow">FRIENDSHIP CHALLENGE COMPLETED</div>
   <h2 class="gradient" style="font-family:'Playfair Display';font-size:42px;margin:20px 0">
    ${score}/5
   </h2>
   <h3 style="font-family:'Playfair Display';font-size:26px;margin-bottom:15px">
    ${score===5?'Perfect Friendship! 💗':score>=3?'You Know Us So Well! 🥹':'More Friendship Practice Needed! 😂'}
   </h3>
   <p style="color:#bbaebc;line-height:1.9;font-size:13px">
    ${score===5?'You know every little thing about our friendship!': 'Our friendship is special. Keep making more memories together!'}
   </p>
   <button class="neon-btn" style="margin-top:25px" onclick="resetQuiz()">
    PLAY AGAIN ↻
   </button>
  </div>
 `;
 createHearts(25);
}

function resetQuiz(){
 quizIndex=0;
 score=0;

 document.querySelector('.quiz-card').innerHTML=`
  <div class="quiz-number" id="quizNumber"></div>
  <div class="quiz-progress"><span id="quizProgress"></span></div>
  <h3 id="question"></h3>
  <div class="quiz-options" id="quizOptions"></div>
  <div id="quizResult"></div>
  <div class="quiz-footer">
   <span id="scoreText">YOUR SCORE: 0</span>
   <button class="neon-btn" id="nextQuestion" onclick="nextQuiz()" style="display:none">NEXT QUESTION →</button>
  </div>
 `;
 loadQuiz();
}

/* =================================
   10. MUSIC PLAYER
================================= */

const audio=document.getElementById('audio');
const musicFile=document.getElementById('musicFile');
const playButton=document.getElementById('playButton');
const progress=document.getElementById('progress');

let musicURL=null;

function formatTime(seconds){
 if(!Number.isFinite(seconds))return '0:00';
 const min=Math.floor(seconds/60);
 const sec=Math.floor(seconds%60);
 return min+':'+String(sec).padStart(2,'0');
}

musicFile.addEventListener('change',function(){
 const file=this.files[0];
 if(!file)return;

 if(!file.type.startsWith('audio/')){
  alert('Please select an audio file.');
  return;
 }

 if(musicURL)URL.revokeObjectURL(musicURL);

 musicURL=URL.createObjectURL(file);
 audio.src=musicURL;

 document.getElementById('songName').textContent=file.name;
 document.getElementById('songArtist').textContent='Your special song for Gartera ♡';
 document.getElementById('musicStatus').textContent='Your song is ready. Press play!';
 document.getElementById('albumArt').textContent='♫';

 audio.load();
 playButton.textContent='▶';
});

function toggleMusic(){
 if(!musicURL){
  alert('First choose your favourite song! 🎵');
  return;
 }

 if(audio.paused){
  audio.play().then(()=>{
   playButton.textContent='Ⅱ';
   document.getElementById('albumArt').classList.add('playing');
   document.getElementById('musicStatus').textContent='NOW PLAYING ♡';
  }).catch(()=>{
   document.getElementById('musicStatus').textContent='Unable to play this file.';
  });
 }else{
  audio.pause();
  playButton.textContent='▶';
  document.getElementById('albumArt').classList.remove('playing');
  document.getElementById('musicStatus').textContent='MUSIC PAUSED';
 }
}

function stopMusic(){
 audio.pause();
 audio.currentTime=0;
 playButton.textContent='▶';
 document.getElementById('albumArt').classList.remove('playing');
 document.getElementById('musicStatus').textContent='MUSIC STOPPED';
}

function restartSong(){
 if(!musicURL)return;
 audio.currentTime=0;
 audio.play().then(()=>{
  playButton.textContent='Ⅱ';
  document.getElementById('albumArt').classList.add('playing');
 });
}

audio.addEventListener('loadedmetadata',()=>{
 document.getElementById('duration').textContent=formatTime(audio.duration);
});

audio.addEventListener('timeupdate',()=>{
 if(!audio.duration)return;

 progress.value=(audio.currentTime/audio.duration)*100;
 document.getElementById('currentTime').textContent=formatTime(audio.currentTime);
});

progress.addEventListener('input',()=>{
 if(audio.duration){
  audio.currentTime=(progress.value/100)*audio.duration;
 }
});

audio.addEventListener('ended',()=>{
 playButton.textContent='▶';
 document.getElementById('albumArt').classList.remove('playing');
});

/* =================================
   11. FINAL SURPRISE
================================= */

function createConfetti(){
 const symbols=['♥','✦','●','✧','💗'];

 for(let i=0;i<65;i++){
  const el=document.createElement('div');
  el.className='confetti';
  el.textContent=symbols[Math.floor(Math.random()*symbols.length)];

  el.style.left=Math.random()*100+'%';
  el.style.color=['#ff3f9f','#ff9bc9','#b77aff','#ffffff'][Math.floor(Math.random()*4)];
  el.style.fontSize=(10+Math.random()*14)+'px';
  el.style.animationDuration=(3+Math.random()*4)+'s';

  document.body.appendChild(el);
  setTimeout(()=>el.remove(),7500);
 }
}

function forgiveMe(){
 document.getElementById('finalMessage').classList.add('show');
 document.getElementById('thinkMessage').style.display='none';

 createHearts(35);
 createConfetti();

 document.getElementById('finalMessage').scrollIntoView({
  behavior:'smooth',
  block:'center'
 });
}

function notYet(){
 const message=document.getElementById('thinkMessage');

 message.style.display='block';
 message.textContent=
  'আচ্ছা ঠিক আছে! সময় নে। তবে আমার সাথে কথা বলা বন্ধ করিস না! 😂💗';

 createHearts(8);
}

/* =================================
   12. SCROLL TO TOP
================================= */

const topBtn=document.getElementById('topBtn');

window.addEventListener('scroll',()=>{
 topBtn.classList.toggle('show',window.scrollY>500);
},{passive:true});

/* =================================
   13. INITIALIZE
================================= */

loadQuiz();

</script>

</body>
</html>

